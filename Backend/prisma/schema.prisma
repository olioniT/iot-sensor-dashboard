generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Sensor { 
  id    Int     @id @default(autoincrement()) 
  name  String  @unique
  temp  Int
  location String
  activestate Boolean @default(false)
} 

model User { 
  id        Int     @id @default(autoincrement()) 
  name String?
  username String @unique
  admin Boolean @default(false)
  password String
} 

model TemperatureReadings { 
  id        Int     @id @default(autoincrement()) 
  sensorid Int
  temperature Int
  time String
} 