generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Sensor { 
  id Int @id @default(autoincrement()) 
  name String @unique
  location String
  status String @default("active")
  min_temperature Decimal
  max_temperature Decimal
  update_interval Int
  created_at String
  created_by Int
} 

model SensorReadings {
  id Int @id @default(autoincrement())
  reading Decimal
  recorded_at String
  sensor_id Int
}

model User { 
  id Int @id @default(autoincrement())
  name String?
  username String @unique
  password String
  role Int 
}

model Role {
  id Int @id @default(autoincrement())
  name String @unique
  description String
}